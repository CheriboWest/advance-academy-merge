PORT=4000
FRONTEND_URL=http://localhost:3000
LLM_PROVIDER=anthropic
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_API_KEY=sk-ant-api03...
# Optional per-feature overrides. If unset, each feature falls back to LLM_API_KEY.
# Outreach key covers Dream Company + Outreach Message features.
LLM_API_KEY_OUTREACH=
# CV key covers the CV Optimizer feature.
LLM_API_KEY_CV=
# Interview key covers Interview Prep + CV Library + everything else.
LLM_API_KEY_INTERVIEW=
LLM_ANTHROPIC_API_VERSION=2023-06-01
LLM_TIMEOUT_MS=30000
LLM_MODEL_DEFAULT=claude-sonnet-4-20250514
LLM_MODEL_CV_OPTIMIZER=claude-sonnet-4-20250514
# CV Optimizer analysis pipeline: "true" = parallel V2 agent pipeline (faster);
# any other value = legacy monolith. Read by the backend (config/features.ts).
CV_OPTIMIZER_USE_V2=true
# Optional per-agent model routing for V2 (defaults: lightweight agents -> Haiku,
# bullets -> LLM_MODEL_CV_OPTIMIZER). Uncomment to override.
# LLM_MODEL_CV_HAIKU=claude-haiku-4-5
# LLM_MODEL_CV_STRUCTURE=
# LLM_MODEL_CV_KEYWORDS=
# LLM_MODEL_CV_BULLETS=
# LLM_MODEL_CV_ALIGNMENT=
LLM_MODEL_OUTREACH=claude-sonnet-4-20250514
LLM_MODEL_DREAM_COMPANY=claude-sonnet-4-20250514
LLM_MODEL_INTERVIEW_PREP=claude-sonnet-4-20250514
# Optional low-latency model for structured IRS scoring. Falls back to the
# Interview Prep model until a candidate model has passed quality evaluation.
LLM_MODEL_INTERVIEW_SCORING=
JINA_API_KEY=jina_...
EXA_API_KEY=...
# --- Dream Company live-vacancy job source (Adzuna + Reed) ---
# Free-tier keys: Adzuna https://developer.adzuna.com | Reed https://www.reed.co.uk/developers
# Leave blank to force the Exa fallback (a missing key makes that source return 503,
# and the orchestrator routes around it).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
# Routing mode: "hybrid" (Adzuna/Reed with Exa fallback), "adzuna_reed" (no Exa),
# or "exa" (legacy Exa only — the byte-identical rollback value). Unknown → hybrid + warn.
DREAM_JOB_SOURCE=hybrid
# Per-source HTTP timeout (ms) and in-memory job-cache TTL (ms, default 20 min).
JOB_SOURCE_TIMEOUT_MS=8000
JOB_CACHE_TTL_MS=1200000
# Freshness: preferred window (days) for "current" jobs, and the absolute ceiling that
# is NEVER exceeded. Set MAX_DAYS=2 for a strict 48h window (may return few jobs for
# narrow roles). The orchestrator widens MAX_DAYS→14→HARD_CAP only if too few jobs pass.
JOB_FRESHNESS_MAX_DAYS=7
JOB_FRESHNESS_HARD_CAP_DAYS=30
# How many of the user's top role titles to search per source (one query each, merged).
JOB_MAX_ROLE_QUERIES=3
# Drop dead links: HTTP-check each job URL and remove 404/410. Set false to disable.
JOB_LIVENESS_ENABLED=true
JOB_LIVENESS_TIMEOUT_MS=4000
# Search radius (km) around the resolved city — widens the net to nearby towns (Adzuna
# `distance`, Reed miles-converted). Set 0 for exact-location only.
JOB_SEARCH_RADIUS_KM=25

# --- Per-student DAILY usage caps (the classroom cost knob) ---
# Max requests per student (userId) per day on each credit-heavy LLM tool. On a 429 the
# student sees a friendly "you've reached today's limit (N/day), resets in …" message.
# Change without a redeploy. Read by backend/src/lib/rate-limit.ts (perUserDaily).
DAILY_LIMIT_CV=5
DAILY_LIMIT_DREAM_COMPANY=3
DAILY_LIMIT_OUTREACH=5
DAILY_LIMIT_INTERVIEW=2
# Required for Interview Prep voice-mode transcription (Groq Whisper large-v3-turbo).
# Free-tier key from https://console.groq.com
GROQ_API_KEY=gsk_...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
MVP_USER_ID=00000000-0000-0000-0000-000000000001
VOYAGE_API_KEY=pa-...

# --- Candidate Acquisition: lead-capture pipe (CA-001) ---
# Master switch. When not exactly "true", POST /api/leads/capture returns 404 so
# the pipe can ship dark and be flipped on without a redeploy.
LEADS_CAPTURE_ENABLED=false
# Public base URL used to build the double-opt-in confirm link in the email.
APP_BASE_URL=http://localhost:3000
# Transactional email provider key (chosen in Bước 5 — Resend or Google SMTP).
# Left blank => backend logs the confirm link to the console instead of sending.
EMAIL_API_KEY=
# Model for any lead-magnet scoring (e.g. public readiness score). Haiku = cheap.
LLM_MODEL_READINESS=claude-haiku-4-5
# Admin allowlist for GET /api/leads (the lead-list/CSV endpoint). Comma-separated
# Supabase user IDs. Personal data lives behind this — empty means nobody is admin.
# Get a user's ID in Supabase Dashboard → Authentication → Users → (click user) → User UID.
ADMIN_USER_IDS=
