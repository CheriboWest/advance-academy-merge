BACKEND_URL=http://localhost:4000
# career-hub's FastAPI service (backend-python). Local default is 8000.
# Server-only: the browser reaches it through the /api/careerhub rewrite in
# next.config.mjs, with the signed-in coach's Supabase token, and app/auth.py
# checks the role.
CAREERHUB_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Referral (CA-001, P3c). Base URL of the quiz funnel that invite links point to,
# e.g. https://quiz.advanceacademy.com — the /referral page builds
# `${NEXT_PUBLIC_QUIZ_URL}/?ref=<code>&utm_source=referral`.
NEXT_PUBLIC_QUIZ_URL=http://localhost:3001
# Where the "Explore Mentorship" CTA links once a user maxes out referrals.
NEXT_PUBLIC_MENTORSHIP_URL=https://advanceacademy.com/mentorship
