# CareerHub UK API environment variables.
# Copy to `.env` for local development (never commit real secrets).

# Your Anthropic API key. Server-side only — never exposed to the frontend.
ANTHROPIC_API_KEY=

# Model to use. Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Request timeout (seconds) for calls to the Anthropic API.
ANTHROPIC_TIMEOUT=30

# Supabase JWT secret (Supabase dashboard → Project Settings → API → JWT Secret).
# Used to verify coach access tokens. Server-side only.
SUPABASE_JWT_SECRET=

# Your Supabase project URL, e.g. https://your-project-ref.supabase.co
# The access token issuer must contain this value.
SUPABASE_URL=

# Supabase service role key (Project Settings → API). Server-side ONLY — never
# expose to the frontend. Used to load/update outreach drafts when sending.
SUPABASE_SERVICE_ROLE_KEY=

# SMTP for sending outreach email via a shared Google Workspace mailbox.
# Use a Gmail App Password (not the account's normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Comma-separated list of allowed CORS origins (your frontend).
# e.g. https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
