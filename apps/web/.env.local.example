# CareerHub UK — web app environment variables
#
# Copy this file to `.env.local` and fill in your Supabase project values.
# Both are safe to expose to the browser (public anon key, read-only access).

# Your Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase project's public anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
