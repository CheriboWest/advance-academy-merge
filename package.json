{
  "name": "careerhub",
  "version": "0.1.0",
  "private": true,
  "description": "CareerHub UK — company and job discovery platform for students, with a private coach workspace.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
